# PostgreSQL. Copy to config/database.yml and adjust credentials if needed.
default: &default
  adapter: postgresql
  encoding: unicode
  max_connections: <%= ENV.fetch("RAILS_MAX_THREADS") { 5 } %>

development:
  <<: *default
  database: qna_development

# Warning: The database defined as "test" will be erased and
# re-generated from your development database when you run "rake".
test:
  <<: *default
  database: qna_test

# Production uses the Solid stack: cache, queue and cable live in their own databases.
production:
  primary: &primary_production
    <<: *default
    database: qna_production
    username: qna
    password: <%= ENV["QNA_DATABASE_PASSWORD"] %>
    host: <%= ENV["DB_HOST"] %>
  cache:
    <<: *primary_production
    database: qna_production_cache
    migrations_paths: db/cache_migrate
  queue:
    <<: *primary_production
    database: qna_production_queue
    migrations_paths: db/queue_migrate
  cable:
    <<: *primary_production
    database: qna_production_cable
    migrations_paths: db/cable_migrate
