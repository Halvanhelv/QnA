li class="list-group-item list-group-item-action" id=dom_id(attachment)
  = link_to attachment.filename, rails_blob_path(attachment.blob, only_path: true)
  span data-controller="visibility" data-visibility-rule-value="owner" data-visibility-owner-id-value=owner_id hidden=true
    = link_to t('delete_attachment'), attachment_path(attachment), data: { turbo_method: :delete }
