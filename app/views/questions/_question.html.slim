article id=dom_id(question) class="panel mt-3 p-5 sm:p-6"
  h1 class="font-display text-3xl font-bold leading-tight sm:text-4xl" = question.title
  div class="mt-3" = byline(question.user, question.created_at)

  div class="mt-6 flex gap-4 sm:gap-6"
    div class="shrink-0"
      = render 'shared/votes', resource: question

    div class="flex min-w-0 flex-1 flex-col gap-5"
      p class="prose-body" = question.body

      - if question.files.attached?
        ul class="flex flex-wrap gap-2"
          - question.files.each do |file|
            = render 'shared/attachment', attachment: file, owner_id: question.user_id

      - if question.links.any?
        ul class="links flex flex-wrap gap-2"
          = render partial: 'links/link', collection: question.links, as: :link

      - if question.reward
        div id="reward" class="flex items-center gap-4 rounded-md border border-accepted/30 bg-accepted-soft p-3"
          - if question.reward.img.attached?
            = image_tag rails_blob_path(question.reward.img, only_path: true), alt: '', class: 'size-14 rounded-md object-cover'
          div
            p class="flex items-center gap-1.5 text-sm font-semibold text-accepted"
              = icon(:trophy)
              | Reward for the best answer
            p class="font-medium" = question.reward.name

      = render 'comments/section', commentable: question

      div data-controller="visibility" data-visibility-rule-value="owner" data-visibility-owner-id-value=question.user_id hidden=true
        div class="-ml-2 flex items-center gap-1"
          = link_to t('questions.question.edit'), edit_question_path(question), class: 'btn btn-quiet', data: { turbo_frame: dom_id(question, :edit) }
          = button_to t('questions.question.delete'), question_path(question), method: :delete, class: 'btn btn-danger', form: { data: { turbo_confirm: 'Delete this question and its answers?' } }
        = turbo_frame_tag dom_id(question, :edit), class: 'empty:hidden'
