= render 'shared/errors', resource: question
= form_with model: question do |f|
  .form-group
    p
    = f.label :title
    = f.text_field :title, class: 'form-control'
    p
    = f.label :body
    = f.text_area :body, class: 'form-control'

    - if question.persisted? && question.files.attached?
      ul.attachments
        - question.files.each do |file|
          = render 'shared/attachment', attachment: file, owner_id: question.user_id
    p
      = f.label :files
      = f.file_field :files, multiple: true, class: 'form-control'
    = render 'shared/links_fields', form: f

    - if question.new_record?
      p
      = f.fields_for :reward, question.reward || question.build_reward do |reward|
        = reward.label :name, t('Reward Name')
        = reward.text_area :name, class: 'form-control'
        p
        = reward.label :img, t('Reward Image')
        = reward.file_field :img, class: 'form-control'
    p
    = f.submit class: 'btn btn-primary'
