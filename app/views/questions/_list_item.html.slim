- answered = question.best_answer.present?
li id=dom_id(question, :list_item) class="flex gap-4 px-4 py-4 transition-colors hover:bg-canvas/60 sm:px-5"
  div class="flex shrink-0 gap-2 self-start"
    div class="w-14 rounded-md px-2 py-1 text-center leading-tight"
      span class="block font-display text-lg font-bold tabular-nums" = question.rating
      span class="text-xs text-muted" votes
    div class="w-16 rounded-md border px-2 py-1 text-center leading-tight #{answered ? 'border-accepted bg-accepted-soft text-accepted' : 'border-line text-muted'}"
      span class="block font-display text-lg font-bold tabular-nums" = question.answers.size
      span class="text-xs" answers
  div class="min-w-0 flex-1"
    = link_to question.title, question_path(question), class: 'font-display text-lg font-semibold leading-snug text-ink no-underline hover:text-brand'
    p class="mt-1 line-clamp-2 text-sm text-muted" = question.plain_body.truncate(240)
    div class="mt-2 empty:hidden" = render 'questions/tags', question: question
    div class="mt-2" = byline(question.user, question.created_at)
