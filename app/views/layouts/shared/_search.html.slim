= form_with url: search_path, scope: :search, method: :get, class: 'flex w-full items-stretch md:max-w-xl rounded-md border border-line-strong bg-surface focus-within:border-brand focus-within:outline-2 focus-within:outline-brand/30', role: 'search' do |f|
  span class="flex items-center pl-3 text-muted" = icon(:search)
  = f.text_field :body, value: params.dig(:search, :body), placeholder: 'Search', 'aria-label': 'Search', class: 'min-w-0 flex-1 border-0 bg-transparent px-2 py-2 text-sm text-ink placeholder:text-muted focus:outline-none'
  div class="choices-bare" data-controller="choices"
    = f.select :scope, Services::Search::SCOPES, { selected: params.dig(:search, :scope) || 'all' }, 'aria-label': 'Search in', data: { choices_target: 'select', search_enabled: 'false' }
  = f.submit 'Search', class: 'btn btn-quiet m-0.5 rounded-[5px]'
