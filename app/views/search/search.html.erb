<% query = @search.query %>
<% content_for :title, (query.present? ? "Search: #{query}" : 'Search') %>
<% result = @search.result %>

<h1 class="font-display text-3xl font-bold">Search</h1>
<p class="mt-1 text-muted">
  <% if @search.tokens.empty? %>
    Type a word or two in the search box above.
  <% else %>
    <%= "#{pluralize(result.total_entries, 'result')} for “#{query}”" %>
  <% end %>
</p>

<% if @search.tokens.any? && result.total_entries.zero? %>
  <div class="panel mt-6 px-5 py-10 text-center">
    <p class="font-display text-lg font-semibold">Nothing found</p>
    <ul class="mx-auto mt-3 max-w-sm space-y-1 text-left text-sm text-muted">
      <li>Check the spelling, or try fewer words.</li>
      <li>Word forms are matched, so "upgrade" also finds "upgrading".</li>
      <% if @search.scope != 'all' %>
        <li>
          <%= link_to 'Search in all sections', search_path(search: { body: query, scope: 'all' }) %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>

<ul class="search-results panel mt-6 divide-y divide-line overflow-hidden empty:hidden">
  <% result.each do |document| %>
    <% record = document.searchable %>
    <% next unless record %>
    <% question = search_hit_question(record) %>
    <li class="px-4 py-4 sm:px-5">
      <div class="flex flex-wrap items-center gap-2 text-sm">
        <span class="chip"><%= record.class.model_name.human %></span>
        <% unless record.is_a?(Question) %>
          <span class="text-muted">
            in <%= link_to highlight_terms(question.title, @search.tokens), question_path(question), class: 'font-medium' %>
          </span>
        <% end %>
      </div>
      <% if record.is_a?(Question) %>
        <%= link_to search_hit_path(record), class: 'mt-1 block font-display text-lg font-semibold leading-snug text-ink no-underline hover:text-brand' do %>
          <%= highlight_terms(record.title, @search.tokens) %>
        <% end %>
      <% end %>
      <p class="mt-1 text-sm leading-6 text-muted">
        <%= link_to search_hit_path(record), class: 'text-muted no-underline hover:text-ink' do %>
          <%= @search.snippets[document.id] %>
        <% end %>
      </p>
      <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1">
        <%= byline(record.user, record.created_at, verb: record.is_a?(Question) ? 'asked' : 'wrote') %>
        <% if record.is_a?(Question) && record.tags.any? %>
          <%= render 'questions/tags', question: record %>
        <% end %>
      </div>
    </li>
  <% end %>
</ul>

<div class="mt-6"><%= will_paginate result, param_name: 'search[page]' %></div>
