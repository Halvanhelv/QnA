<div id="question-subscription" class="flex justify-end">
  <% if current_user %>
    <% if question.subscribed?(current_user) %>
      <%= button_to subscription_path(question.subscription(current_user)), method: :delete, class: 'btn btn-ghost' do %>
        <%= icon(:bell) %>
        <%= t('unsubscribe') %>
      <% end %>
    <% else %>
      <%= button_to question_subscriptions_path(question), class: 'btn btn-ghost' do %>
        <%= icon(:bell) %>
        <%= t('subscribe') %>
      <% end %>
    <% end %>
  <% end %>
</div>
