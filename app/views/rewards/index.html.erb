<% content_for :title, t('all rewards') %>
<h1 class="mb-6 font-display text-3xl font-bold sm:text-4xl"><%= t('all rewards') %></h1>

<% if @rewards.any? %>
  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @rewards.each do |reward| %>
      <li class="panel flex items-center gap-4 p-4">
        <%= image_tag rails_blob_path(reward.img, only_path: true), alt: '', class: 'size-20 shrink-0 rounded-md object-cover' %>
        <div class="min-w-0">
          <p class="flex items-center gap-1.5 text-sm font-semibold text-accepted">
            <%= icon(:trophy) %>
            <%= reward.name %>
          </p>
          <%= link_to reward.question.title, question_path(reward.question), class: 'font-display font-semibold leading-snug text-ink hover:text-brand' %>
        </div>
      </li>
    <% end %>
  </ul>
<% else %>
  <div class="panel px-5 py-12 text-center">
    <p class="font-display text-lg font-semibold"><%= t('no rewards') %></p>
    <p class="mt-1 text-muted">Answer a question with a reward and get picked as best to earn one.</p>
  </div>
<% end %>
