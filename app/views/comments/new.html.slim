= turbo_frame_tag dom_id(commentable, :new_comment)
  = render 'shared/errors', resource: @comment
  .form-group.comment-block
    = form_with model: [commentable, @comment] do |f|
      .form-group
        = f.label :body
        = f.text_area :body, class: 'form-control col-md-3'
        br
        = f.submit t('save comment'), class: 'button btn btn-primary', style: 'font-size: 8pt'
