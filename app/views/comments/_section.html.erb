<section class="border-t border-line pt-3" aria-label="Comments">
  <ul id="<%= dom_id(commentable, :comments) %>" class="space-y-2 empty:hidden">
    <%= render commentable.comments %>
  </ul>
  <div data-controller="visibility" data-visibility-rule-value="signed_in" hidden>
    <%= render 'comments/new_link', commentable: commentable %>
  </div>
</section>
