<div class="auth-card">
  <h1 class="font-display text-2xl font-bold"><%= "Sign up" %></h1>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <div class="field">
      <%= f.label :email, nil, class: "label" %>
      <%= f.email_field :email, class: "input", autofocus: true, autocomplete: "email" %>
    </div>
    <div class="field">
      <%= f.label :password, class: "label" %>
      <%= f.password_field :password, class: "input", autocomplete: "new-password" %>
      <% if @minimum_password_length %>
        <p class="text-xs text-muted"><%= @minimum_password_length %> characters minimum</p>
      <% end %>
    </div>
    <div class="field">
      <%= f.label :password_confirmation, nil, class: "label" %>
      <%= f.password_field :password_confirmation, class: "input", autocomplete: "new-password" %>
    </div>

    <%= f.submit "Sign up", class: "btn btn-primary w-full" %>
  <% end %>
  <%= render "devise/shared/links" %>
</div>
