<div class="auth-card">
  <h1 class="font-display text-2xl font-bold"><%= "Log in" %></h1>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <div class="field">
      <%= f.label :email, nil, class: "label" %>
      <%= f.email_field :email, class: "input", autofocus: true, autocomplete: "email" %>
    </div>
    <div class="field">
      <%= f.label :password, nil, class: "label" %>
      <%= f.password_field :password, class: "input", autocomplete: "current-password" %>
    </div>
    <% if devise_mapping.rememberable? %>
      <div class="flex items-center gap-2">
        <%= f.check_box :remember_me, class: "size-4 rounded border-line-strong accent-brand" %>
        <%= f.label :remember_me, class: "text-sm" %>
      </div>
    <% end %>

    <%= f.submit "Log in", class: "btn btn-primary w-full" %>
  <% end %>
  <%= render "devise/shared/links" %>
</div>
