<%= mail_heading 'Confirm your email' %>
<%= mail_paragraph "Welcome to Qna, #{@email}. Confirm your address to start asking and answering questions." %>
<%= mail_button 'Confirm email', confirmation_url(@resource, confirmation_token: @token) %>
<%= mail_fallback_link confirmation_url(@resource, confirmation_token: @token) %>
<%= mail_paragraph "If you did not create an account, you can ignore this email.", muted: true %>
