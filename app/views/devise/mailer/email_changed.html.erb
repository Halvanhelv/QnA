<%= mail_heading 'Your email address changed' %>
<% if @resource.try(:unconfirmed_email?) %>
  <%= mail_paragraph "A change of your email address to #{@resource.unconfirmed_email} was requested. It takes effect once the new address is confirmed." %>
<% else %>
  <%= mail_paragraph "The email address for your account is now #{@resource.email}." %>
<% end %>
<%= mail_paragraph "If you did not make this change, contact us as soon as possible.", muted: true %>
