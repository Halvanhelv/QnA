<%= mail_heading 'Choose a new password' %>
<%= mail_paragraph "Someone asked to reset the password for #{@resource.email}. Use the button below to choose a new one." %>
<%= mail_button 'Change password', edit_password_url(@resource, reset_password_token: @token) %>
<%= mail_fallback_link edit_password_url(@resource, reset_password_token: @token) %>
<%= mail_paragraph "If this was not you, ignore this email. Your password stays the same until you open the link and set a new one.", muted: true %>
