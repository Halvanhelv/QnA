<div class="auth-card">
  <h1 class="font-display text-2xl font-bold"><%= "Choose a new password" %></h1>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>
    <div class="field">
      <%= f.label :password, "New password", class: "label" %>
      <%= f.password_field :password, class: "input", autofocus: true, autocomplete: "new-password" %>
    </div>
    <div class="field">
      <%= f.label :password_confirmation, "Confirm new password", class: "label" %>
      <%= f.password_field :password_confirmation, class: "input", autocomplete: "new-password" %>
    </div>

    <%= f.submit "Change password", class: "btn btn-primary w-full" %>
  <% end %>
  <%= render "devise/shared/links" %>
</div>
