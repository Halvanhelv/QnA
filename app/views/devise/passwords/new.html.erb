<div class="auth-card">
  <h1 class="font-display text-2xl font-bold"><%= "Forgot your password?" %></h1>
  <p class="text-sm text-muted">Enter your email and we will send you a link to choose a new password.</p>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <div class="field">
      <%= f.label :email, nil, class: "label" %>
      <%= f.email_field :email, class: "input", autofocus: true, autocomplete: "email" %>
    </div>

    <%= f.submit "Send reset instructions", class: "btn btn-primary w-full" %>
  <% end %>
  <%= render "devise/shared/links" %>
</div>
