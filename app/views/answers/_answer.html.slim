- best = answer.accepted?
article id=dom_id(answer) data-controller="arrival" data-arrival-at-value=answer.created_at.iso8601(3) data-arrival-author-id-value=answer.user_id class="panel p-5 sm:p-6 #{best ? 'border-l-4 !border-l-accepted' : ''}"
  - if best
    p class="mb-3 inline-flex items-center gap-1.5 rounded-full bg-accepted-soft px-2.5 py-0.5 text-xs font-semibold text-accepted"
      = icon(:check, 'size-3.5')
      | Accepted answer

  div class="flex gap-4 sm:gap-6"
    div class="flex shrink-0 flex-col items-center gap-3"
      = render 'shared/votes', resource: answer
      - unless best
        div data-controller="visibility" data-visibility-rule-value="owner" data-visibility-owner-id-value=answer.question.user_id hidden=true
          = button_to answer_acceptance_path(answer), class: 'vote-btn hover:!border-accepted hover:!bg-accepted-soft hover:!text-accepted', 'aria-label': t('answers.answer.best'), title: t('answers.answer.best') do
            = icon(:check, 'size-5')

    div class="flex min-w-0 flex-1 flex-col gap-4"
      div class="prose-body" = answer.body.to_s

      - if answer.files.attached?
        ul class="flex flex-wrap gap-2"
          - answer.files.each do |file|
            = render 'shared/attachment', attachment: file, owner_id: answer.user_id

      - if answer.links.any?
        ul class="links flex flex-wrap gap-2"
          = render partial: 'links/link', collection: answer.links, as: :link

      = render 'comments/section', commentable: answer

      div class="flex flex-wrap items-center justify-between gap-2"
        = byline(answer.user, answer.created_at, verb: 'answered')
        div data-controller="visibility" data-visibility-rule-value="owner" data-visibility-owner-id-value=answer.user_id hidden=true
          div class="flex items-center gap-1"
            = link_to t('edit_answer'), edit_answer_path(answer), class: 'btn btn-quiet', data: { turbo_frame: dom_id(answer, :edit) }
            = button_to t('delete_answer'), answer_path(answer), method: :delete, class: 'btn btn-danger', form: { data: { turbo_confirm: 'Delete this answer?' } }

      = turbo_frame_tag dom_id(answer, :edit), class: 'empty:hidden'
