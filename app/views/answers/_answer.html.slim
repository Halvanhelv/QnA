ul.list-group id=dom_id(answer)
  - if answer.best_answer?
    div.best-answer
      = answer.body
  - else
    div
      = answer.body

  = render 'shared/votes', resource: answer

  .links
    p Links:
    ul
      = render partial: 'links/link', collection: answer.links, as: :link

  = render 'comments/section', commentable: answer

  ul.list-group
    - answer.files.each do |file|
      = render 'shared/attachment', attachment: file, owner_id: answer.user_id
    p.btn.btn-outline-info
      = answer.user.email

  div data-controller="visibility" data-visibility-rule-value="owner" data-visibility-owner-id-value=answer.user_id hidden=true
    = button_to t('delete_answer'), answer_path(answer), method: :delete, class: 'btn btn-outline-danger'
    p= link_to t('edit_answer'), edit_answer_path(answer), class: 'btn btn-outline-warning', data: { turbo_frame: dom_id(answer, :edit) }
    = turbo_frame_tag dom_id(answer, :edit)

  div data-controller="visibility" data-visibility-rule-value="owner" data-visibility-owner-id-value=answer.question.user_id hidden=true
    p= button_to t('answers.answer.best'), best_answer_answer_path(answer), method: :patch, class: 'btn btn-dark'
