<section id="new-answer" class="panel mt-8 p-5 sm:p-6">
  <h2 class="mb-4 font-display text-xl font-bold">Your answer</h2>
  <%= render 'shared/errors', resource: answer %>
  <%= form_with model: [question, answer], class: 'new-answer space-y-4', data: { controller: 'submit-shortcut', action: 'keydown->submit-shortcut#submit' } do |f| %>
    <div class="field">
      <%= f.label :body, 'Answer', class: 'label' %>
      <%= f.rich_text_area :body, placeholder: 'Explain what worked and why. Markdown and code blocks work.' %>
    </div>
    <div class="field">
      <%= f.label :files, 'Attachments', class: 'label' %>
      <%= f.file_field :files, multiple: true, class: 'file-input' %>
    </div>
    <%= render 'shared/links_fields', form: f %>
    <%= f.submit class: 'btn btn-primary', data: { turbo_submits_with: 'Posting...' } %>
  <% end %>
</section>
